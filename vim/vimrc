" Restore cursor position when reopening a file
autocmd BufReadPost *
    \ if line("'\"") > 0 && line("'\"") <= line("$") |
    \   execute "normal! g`\"" |
    \ endif

nnoremap <SPACE> <Nop>
let mapleader = ' '
nnoremap <leader>e :Explore<CR>
nnoremap <C-h> :bp<CR>
nnoremap <C-l> :bn<CR>

source ~/.config/vim/plugins.vim
source ~/.config/vim/vasp.vim

syntax on
filetype plugin indent on
set number
set hidden
set clipboard=unnamedplus
set tabstop=2
set shiftwidth=2
set softtabstop=2
set smartindent
set showmatch
set hlsearch
set ignorecase
set backspace=indent,eol,start
set undofile
set undodir=~/.config/vim/undo//
set directory=~/.config/vim/swap//

colorscheme unokai
